		<Item Name="Convert Homography to Pose.vi" Type="VI" URL="../Convert Homography to Pose.vi"/>
		<Item Name="Manage Camera.vi" Type="VI" URL="../Manage Camera.vi"/>
		<Item Name="ReadMe.html" Type="Document" URL="../ReadMe.html"/>
