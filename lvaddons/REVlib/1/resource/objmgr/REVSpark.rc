    "PID:Slot 1:Model Gains"
	cluster { 5, "kS" = fD, "kA" = fD, "kG"=fD, "kCos"=fD, "Cos Ratio"=fD } readwrite	29	  20E
	"PID Slot 1 Model Values: Coefficients to help overcome static friction, apply acceleration boost, and terms for gravity compensation on linear or radial position control."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

