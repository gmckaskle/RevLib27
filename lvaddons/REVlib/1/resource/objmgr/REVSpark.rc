    "PID:Slot 3:Model Gains"
	cluster { 5, "kS" = fD, "kA" = fD, "kG"=fD, "kCos"=fD, "Cos Ratio"=fD } readwrite	29	  216
	"PID Slot 3 Model Values: Coefficients to help overcome static friction, apply acceleration boost, and terms for gravity compensation on linear or radial position control."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"



attribute:  EncoderInverted	
    "Sensor:Encoder:Inverted"
	bool	readwrite	29	  48
	"Encoder Inverted: Sets whether the encoder direction is inverted."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  EncoderCountsPerRev	
    "Sensor:Encoder:Counts Per Rev"
	uL	readwrite	29	  45
	"Encoder Counts Per Rev: Sets the Primary Encoder's counts per revolution. Sparks only use this when in brushed mode. Note: Spark Flex will need a Flex Dock in order run in brushed mode."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  EncoderAverageDepth	
    "Sensor:Encoder:Average Depth"
	uL	readwrite	29	  46
	"Encoder Average Depth: Configures the Primary Encoder's velocity averaging filter size."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  EncoderSampleDelta	
    "Sensor:Encoder:Sample Delta"
	uL	readwrite	29	  47
	"Encoder Sample Delta: Configures the Primary Encoder's time delta between collected samples for velocity averaging in increments of 500us."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  EncoderPositionValue	
    "Sensor:Encoder:Position"
	fD	readwrite	29	  217
	"Encoder Position Value: Most recent position for the internal encoder."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  EncoderVelocityValue	
    "Sensor:Encoder:Velocity"
	fD	readonly	29	  218
	"Encoder Velocity Value: Most recently calculated velocity for the internal encoder."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"



attribute:  DutyCycleInverted	
    "Sensor:Abs Encoder:Inverted"
	bool	readwrite	29	  8D
	"Duty Cycle Inverted: Sets whether the Duty Cycle Encoder values are inverted."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  DutyCycleAverageDepth	
    "Sensor:Abs Encoder:Average Depth"
	uL	readwrite	29	  8F
	"Duty Cycle Average Depth: The Duty Cycle sensor's velocity averaging filter size. Sets the number of samples used in the averaging filter as a power of 2. For example, a value of 3 sets the filter size to 2^(3) = 8 samples."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  DutyCycleRangeOffset	
    "Sensor:Abs Encoder:Range Offset"
	fD	readwrite	29	  92
	"Duty Cycle Range Offset: Sets the Duty Cycle Encoder Range offset about zero. Moves the range between (-1, 0] and [0, 1), instead of the default range [0, 1), assuming the default units of rotations."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  DutyCycleSensorPrescaler	
    "Sensor:Abs Encoder:Sensor Prescaler"
	uL	readwrite	29	  99
	"Duty Cycle Sensor Prescaler: Used for adjusting the maximum duty cycle period supported. Contact REV Robotics for more help."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  DutyCycleOffset	
    "Sensor:Abs Encoder:Offset"
	fD	readwrite	29	  9A
	"Duty Cycle Offset: Sets the Duty Cycle sensor position offset. Must be from 0 to 1."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  DutyCycleEncoderStartPulseUs	
    "Sensor:Abs Encoder:Start Pulse microsec"
	fD	readwrite	29	  C4
	"Duty Cycle Encoder Start Pulse Us: Sets the expected start pulse of the input duty cycle signal in us."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  DutyCycleEncoderEndPulseUs	
    "Sensor:Abs Encoder:End Pulse microsec"
	fD	readwrite	29	  C5
	"Duty Cycle Encoder End Pulse Us: Sets the expected end pulse of the input duty cycle signal in us."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  DutyCyclePositionValue	
    "Sensor:Abs Encoder:Position"
	fD	readwrite	29	  22B
	"Duty Cycle Encoder Position: Most recent position for the absolute encoder."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  DutyCycleVelocityValue	
    "Sensor:Abs Encoder:Velocity"
	fD	readonly	29	  22C
	"Duty Cycle Encoder Velocity: Most recently calculated velocity for the absolute encoder."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"



attribute:  LimitSwitchFwdPolarity	
    "Sensor:Limit Switch:Forward Polarity"
	bool	readwrite	29	  32
	"Limit Switch Fwd Polarity: Sets whether the hardware forward limit switch is normally-open or normally-closed."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  HardLimitFwdEn	
    "Sensor:Limit Switch:Forward Enable"
	uL    enum {"Move"=0, "Stop"=1, "Set Sensor"=2, "Stop & Set Sensor"=3}    readwrite	29	  34
	"Hard Limit Fwd En: The forward limit switch mode. Sets the behavior for when the limit switch is triggered."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  LimitSwitchFwdValue	
    "Sensor:Limit Switch:Forward Limit Reached"
	bool	readwrite	29	  219
	"Hard Limit Fwd Value: Indicates whether the forward limit was reached."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  LimitSwitchRevPolarity	
    "Sensor:Limit Switch:Reverse Polarity"
	bool	readwrite	29	  33
	"Limit Switch Rev Polarity: Sets whether the hardware reverse limit switch is normally-open or normally-closed."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  HardLimitRevEn	
    "Sensor:Limit Switch:Reverse Enable"
	uL    enum {"Move"=0, "Stop"=1, "Set Sensor"=2, "Stop & Set Sensor"=3}    readwrite	29	  35
	"Soft Limit Rev En: Sets whether the soft reverse limit is enabled."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  LimitSwitchRevValue	
    "Sensor:Limit Switch:Reverse Limit Reached"
	bool	readwrite	29	  21A
	"Hard Limit Rev Value: Indicates whether the reverse limit was reached."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  LimitSwitchPositionSensor	
    "Sensor:Limit Switch:Position Sensor"
	uL	enum	{"None"=0, "Main Encoder"=1, "Analog"=2, "Alt Encoder"=3, "Duty Cycle"=4, "Detached Absolute"=5, "Detached Relative"=6}    readwrite	29	  C9
