	cluster { 4, "kP" = fD, "kI" = fD, "kD"=fD, "kF"=fD } readwrite	29	  213
	"PID Slot 3 Coefficients: kP, kI, kD, and the velocity feed-forward coefficient kF"	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

