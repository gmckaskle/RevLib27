	cluster { 2, "min" = fD, "max" = fD } readwrite	29	  210
	"PID Slot 2 Output Range: Limits to keep the outputs from PID in a safe and controllable range."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

