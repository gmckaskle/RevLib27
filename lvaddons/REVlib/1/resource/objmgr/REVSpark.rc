RCversion: 3
include: "RevSpark.rch"

 ///// REVSpark Class Definition /////
 class: RevSpark
genericType: RevSpark
passAttributeError: none
className: RevSpark
flags: 0




attribute:  Inverted	
    "Power:Inverted"
	bool	readwrite	29	  2D
	"Inverted: Sets whether the direction the motor is driven is inverted."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  IdleMode	
    "Power:Idle Mode"
	uL	enum	{"Coast"=0, "Brake"=1}    readwrite	29	  6
	"Idle Mode: Spark's disabled behavior type."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  PowerDash	
    "Power:-"
	uL	readwrite	29	  6
	"dash"	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  InputDeadband	
    "Power:Input Deadband"
	fD	readwrite	29	  7
	"Input Deadband: The proportion size of the PWM input period region for idling/disabling the motor in PWM mode."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  OpenLoopRampRate	
    "Power:Open Loop Ramp Rate"
	fD	readwrite	29	  38
	"Open Loop Ramp Rate: Ramp rate for the duty cycle applied to the motor with open-loop control. This value is the desired change in duty cycle per second."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  PowerDash1	
    "Power:-"
	fD	readwrite	29	  0
	"dash"	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  SmartCurrentStallLimit	
    "Power:Smart Current Stall Limit"
	uL	readwrite	29	  3B
	"Smart Current Stall Limit: The smart phase current upper limit."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  SmartCurrentFreeLimit	
    "Power:Smart Current Free Limit"
	uL	readwrite	29	  3C
	"Smart Current Free Limit: The expected phase current when the motor is free spinning. Used when the motor RPM has reached above the 'Smart Current Config' RPM threshold and will linearly reduce the current limit to the free limit current configured."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  SmartCurrentConfig	
    "Power:Smart Current Config"
	uL	readwrite	29	  3D
	"Smart Current Config: The Smart Current configuration settings. Currently sets the RPM threshold that will begin reducing the phase current upper limit to the 'Smart Current Free Limit'. Set to an RPM value higher than the motor free speed to disable this behavior."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  VoltageCompensation	
    "Power:Voltage Compensation"
	typedef "<vilib>:REV Custom Controls\Spark Voltage Compensation.ctl"    readwrite	29	  200
	"Voltage Compensation Mode: Sets the type of voltage compensation. 'Nominal Voltage Compensation Mode' will scale the applied output at the current voltage level to the configured nominal voltage level. This helps with driving consistency as voltage levels change."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  CurrentChop	
    "Power:Current Chop"
	fD	readwrite	29	  B
	"Current Chop: The phase current threshold for activating the current chopping protection mechanism. Current chopping will attempt to average out the phase currents of the motor to below the threshold by disabling the motor for the number of 'Current Chop Cycles' and resume afterwards."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  CurrentChopCycles	
    "Power:Current Chop Cycles"
	uL	readwrite	29	  C
	"Current Chop Cycles: The number of cycles that the motor will brake for when the motor phase currents reach above the current chop threshold."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  PowerDash2	
    "Power:-"
	fD	readwrite	29	  0
	"dash"	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  MotorOutputCurrent	
    "Power:Output Current"
	fD  readonly	29	  201
	"Motor Output Current: The amps being consumed by the motor."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  MotorTemperature
    "Power:Motor Temperature"
	fD  readonly	29	  202
	"Motor Temperature: Temperature of motor controller in degC."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"
	
attribute:  MotorBusVoltage	
    "Power:Bus Voltage"
	fD  readonly	29	  203
	"Motor Bus Voltage: The input voltage to the motor controller."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"
	
attribute:  MotorAppliedOutput
    "Power:Applied Output"
	fD  readonly	29	  204
	"Motor Applied Output: The equivalent DC volts being applied to the motor."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"


attribute:  FollowerModeInfo	
    "Follow"
	cluster {2, "Leader CAN ID"=uL, "Inverted"=bool}	readwrite	29	  205
	"Follower Info: Is the duty cycle value received from the leader Spark be inverted. CAN ID of the leader Spark."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"



attribute:  ControlType	
    "PID:Control Type"
	uL	enum	{"Duty Cycle"=0, "Velocity"=1, "Voltage"=2, "Position"=3, "Current"=4, "MaxMotion Position"=5, "MaxMotion Velocity"=6}    readonly	29	  5
	"Control Type: The setpoint control type last accepted by the Spark. This should not be modified directly."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  ClosedLoopControlSensor	
    "PID:Closed Loop Control Sensor"
	uL	enum	{"None"=0, "Main Encoder"=1, "Analog"=2, "Alt Encoder"=3, "Duty Cycle"=4, "Detached Absolute"=5, "Detached Relative"=6}    readwrite	29	  9
	"Closed Loop Control Sensor: The reference/feedback sensor type used for closed loop motor control."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  PositionPIDWrap	
    "PID:Position PID Wrap"
	cluster { 3, "Enable" = bool, "Min" = fD, "Max"=fD } readwrite	29	  206
	"Position PID Wrap Info: Determine if the position wraps between the ranges of 'Min' and 'Max'."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  DetachedEncoderDeviceID	
    "PID:Detached Encoder Device ID"
	uL	readwrite	29	  E2
	"Detached Encoder Device ID: Sets the Detached Encoder CAN ID for Closed-Loop PID control."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  PIDDash	
    "PID:-"
	uL	readwrite	29	  0
	"dash"	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  PIDF_0	
    "PID:Slot 0:PIDF Gains"
	cluster { 4, "kP" = fD, "kI" = fD, "kD"=fD, "kF"=fD } readwrite	29	  207
	"PID Slot 0 Coefficients: kP, kI, kD, and the velocity feed-forward coefficient kF."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  PIDOutRng_0	
    "PID:Slot 0:Output Range"
	cluster { 2, "min" = fD, "max" = fD } readwrite	29	  208
	"PID Slot 0 Output Range: Limits to keep the outputs from PID in a safe and controllable range."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  PIDAdv_0	
    "PID:Slot 0:Advanced:All Elements"
	cluster { 4, "i Zone" = fD, "max I Accum" = fD, "d Filter"=fD, "error Limit"=fD } readwrite	29	  209
	"PID Slot 0 Advanced Settings: The error zone where accumulation is helpful to control versus where it should be reset to avoid further instability. Max limits how large accumulated integral error can become, d filter can keep sensor noise from destabilizing control, and a limit on the error term before PID calculation."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  PIDAdv0Dash	
    "PID:Slot 0:Advanced::-"
	uL	readwrite	29	  0
	"dash"	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  PIDAdv_0_iZone	
    "PID:Slot 0:Advanced:i Zone"
	fD readwrite	29	  11
	"PID Slot 0 Advanced i Zone: The error zone where accumulation is helpful to control versus where it should be reset to avoid further instability."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  PIDAdv_0_maxAccum	
    "PID:Slot 0:Advanced:max I Accum"
	fD readwrite	29	  60
	"PID Slot 0 Advanced Max I Accum: Limit accumulated integral error to cap the contribution and help with built-up overshoot."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  PIDAdv_0_dFilter	
    "PID:Slot 0:Advanced:d Filter"
	fD readwrite	29	  12
	"PID Slot 0 Advanced d FIlter: Low-pass filter for derivative error to mediate sensor noise."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  PIDAdv_0_ErrorLimit	
    "PID:Slot 0:Advanced:Error Limit"
	fD readwrite	29	  61
	"PID Slot 0 Advanced Error Limit: Cap reaction to large error term."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"




attribute:  PIDModel_0	
    "PID:Slot 0:Model Gains"
	cluster { 5, "kS" = fD, "kA" = fD, "kG"=fD, "kCos"=fD, "Cos Ratio"=fD } readwrite	29	  20A
	"PID Slot 0 Model Values: Coefficients to help overcome static friction, apply acceleration boost, and terms for gravity compensation on linear or radial position control."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  PIDF_1	
    "PID:Slot 1:PIDF Gains"
	cluster { 4, "kP" = fD, "kI" = fD, "kD"=fD, "kF"=fD } readwrite	29	  20B
	"PID Slot 1 Coefficients: kP, kI, kD, and the velocity feed-forward coefficient kF"	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  PIDOutRng_1	
    "PID:Slot 1:Output Range"
	cluster { 2, "min" = fD, "max" = fD } readwrite	29	  20C
	"PID Slot 1 Output Range: Limits to keep the outputs from PID in a safe and controllable range."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  PIDAdv_1	
    "PID:Slot 1:Advanced:All Elements"
	cluster { 4, "i Zone" = fD, "max I Accum" = fD, "d Filter"=fD, "error Limit"=fD } readwrite	29	  20D
	"PID Slot 1 Advanced Settings: The error zone where accumulation is helpful to control versus where it should be reset to avoid further instability. Max limits how large accumulated integral error can become, d filter can keep sensor noise from destabilizing control, and a limit on the error term before PID calculation."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  PIDAdv1Dash	
    "PID:Slot 1:Advanced::-"
	uL	readwrite	29	  0
	"dash"	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  PIDAdv_1_iZone	
    "PID:Slot 1:Advanced:i Zone"
	fD readwrite	29	  19
	"PID Slot 1 Advanced i Zone: The error zone where accumulation is helpful to control versus where it should be reset to avoid further instability."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  PIDAdv_1_maxAccum	
    "PID:Slot 1:Advanced:max I Accum"
	fD readwrite	29	  64
	"PID Slot 1 Advanced Max I Accum: Limit accumulated integral error to cap the contribution and help with built-up overshoot."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  PIDAdv_1_dFilter	
    "PID:Slot 1:Advanced:d Filter"
	fD readwrite	29	  1A
	"PID Slot 1 Advanced d FIlter: Low-pass filter for derivative error to mediate sensor noise."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"

attribute:  PIDAdv_1_ErrorLimit	
    "PID:Slot 1:Advanced:Error Limit"
	fD readwrite	29	  65
	"PID Slot 1 Advanced Error Limit: Cap reaction to large error term."	"REVSpark_Properties.html"	"..\..\help\REVSpark_Reference.chm"





