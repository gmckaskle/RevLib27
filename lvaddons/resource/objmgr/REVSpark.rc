RCversion: 3
include: "RevSpark.rch"

 ///// IMAQdx Class Definition /////
 class: RevSpark
genericType: RevSpark
passAttributeError: none
className: RevSpark
flags: 0

event:	FrameDone	"Frame Done"	0	2
	BufferInterval	numeric	uInt32	value	config
	ActualBufferNumber	numeric	uInt32	value	data
	"Execute an event handler when a frame done event occurs."	"IMAQdx_Register_Events.html#details"	"..\..\help\NI-IMAQdx_VI_Reference.chm"

event:	PnP	"Plug and Play"	1	1
	Event	numeric	uInt32		enum	{"Camera Attached"=0, "Camera Detached"=1, "Bus Reset"=2}	value	configdata
	"Execute an event handler when a plug and play event occurs."	"IMAQdx_Register_Events.html#details"	"..\..\help\NI-IMAQdx_VI_Reference.chm"

event:	AttributeUpdated	"Attribute Updated"	2	1
	Name	string	StrHandle	in	configdata
	"Execute an event handler when an attribute updated event occurs."	"IMAQdx_Register_Events.html#details"	"..\..\help\NI-IMAQdx_VI_Reference.chm"

event:	IOSignalEdge	"IO Signal Edge"	3	3
	"Signal Type"	numeric	uInt32	enum	{"TTL"=0, "RTSI"=1, "Iso In"=2, "Iso Out"=3}	value	configdata
	"Signal Number"	numeric	uInt32	value	configdata
	"Signal Edge"	numeric	uInt32	enum	{"Rising Edge"=0, "Falling Edge"=1}	value	configdata
	"Execute an event handler when an IO signal edge event occurs."	"IMAQdx_Register_Events.html#details"	"..\..\help\NI-IMAQdx_VI_Reference.chm"

event:	StatusSignal	"Status Signal"	4	1
	"Signal Type"	numeric	uInt32	enum	{"Acquisition Active"=0, "Acquisition Done"=1, "Frame Start"=2, "Frame Done"=3, "Buffer Complete"=4}	value	configdata
	"Execute an event handler when a status signal event occurs."	"IMAQdx_Register_Events.html#details"	"..\..\help\NI-IMAQdx_VI_Reference.chm"

